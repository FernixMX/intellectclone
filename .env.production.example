# =============================================================================
# IntellectClone — Variables de entorno para producción
# Copiar como .env.production y completar todos los valores marcados con CHANGE
# NUNCA commitear .env.production — está en .gitignore
# =============================================================================

# Entorno
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# Los servicios dentro de Docker se conectan vía red interna (postgres:5432).
# El puerto 5433 es el externo del host (para DBeaver u acceso directo).
# ---------------------------------------------------------------------------
POSTGRES_USER=intellectclone
POSTGRES_PASSWORD=CHANGE_strong_postgres_password
POSTGRES_DB=intellectclone_prod
DATABASE_URL=postgresql+asyncpg://intellectclone:CHANGE_strong_postgres_password@postgres:5432/intellectclone_prod

# ---------------------------------------------------------------------------
# Redis
# Conexión interna Docker (redis:6379). Puerto externo del host: 6380.
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_strong_redis_password
REDIS_URL=redis://:CHANGE_strong_redis_password@redis:6379/0

# ---------------------------------------------------------------------------
# JWT — generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_generate_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# CORS — dominio público del frontend
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["https://elegant-keller.212-227-239-140.plesk.page"]

# ---------------------------------------------------------------------------
# LLMs
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=CHANGE_sk-ant-...
GEMINI_API_KEY=CHANGE_optional
OPENAI_API_KEY=CHANGE_optional

LLM_MODELO_DEFAULT=anthropic:claude-sonnet-4-6
LLM_PRESUPUESTO_MENSUAL_USD=500.0
LLM_ALERTA_PORCENTAJE=80

# ---------------------------------------------------------------------------
# Almacenamiento (volumen Docker montado en /app/storage)
# ---------------------------------------------------------------------------
STORAGE_PATH=/app/storage

# ---------------------------------------------------------------------------
# Cosecha
# ---------------------------------------------------------------------------
OPENALEX_POLITE_EMAIL=fernando.diaz@uat.edu.mx
ROR_ID_UAT=https://ror.org/04hhneb29

# ---------------------------------------------------------------------------
# Admin — panel de administración
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
# Si se deja vacío, el admin queda abierto (modo desarrollo).
# ---------------------------------------------------------------------------
ADMIN_SECRET_KEY=CHANGE_generate_with_secrets_token_hex_32

# ---------------------------------------------------------------------------
# Next.js frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://elegant-keller.212-227-239-140.plesk.page/api
NEXT_PUBLIC_ADMIN_PROTECTED=true
