# =============================================================================
# IntellectClone — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el .env — está en .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL
# Ajusta POSTGRES_HOST si el contenedor tiene un nombre distinto.
# -----------------------------------------------------------------------------
POSTGRES_USER=intellectclone
POSTGRES_PASSWORD=cambia_esto_en_produccion
POSTGRES_DB=intellectclone_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL completa (la usa el backend FastAPI y Alembic)
DATABASE_URL=postgresql+asyncpg://intellectclone:cambia_esto_en_produccion@localhost:5432/intellectclone_dev

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# JWT — genera con: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_de_64_chars_minimo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS — orígenes permitidos (frontend dev + producción)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# LLMs — API keys de proveedores
# Obtén las keys en: console.anthropic.com, aistudio.google.com, platform.openai.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...

# Modelo default del sistema (R8: Claude Sonnet 4.6)
LLM_MODELO_DEFAULT=anthropic:claude-sonnet-4-6

# Presupuesto mensual en USD (0 = sin límite)
LLM_PRESUPUESTO_MENSUAL_USD=500.0
LLM_ALERTA_PORCENTAJE=80

# -----------------------------------------------------------------------------
# Almacenamiento de archivos (PDFs, backups temporales)
# En desarrollo, usar un path local. En producción: /var/intellectclone/storage
# -----------------------------------------------------------------------------
STORAGE_PATH=./storage

# -----------------------------------------------------------------------------
# Cosecha — configuración de harvesters
# -----------------------------------------------------------------------------
OPENALEX_POLITE_EMAIL=fernando@uat.edu.mx
ROR_ID_UAT=https://ror.org/00qm7vk32

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# NEXT_PUBLIC_* son visibles en el browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambia_esto_por_otro_secreto_aleatorio
